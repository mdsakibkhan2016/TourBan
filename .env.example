# TourBan environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

APP_URL=https://your-domain.com
APP_ENV=production
APP_DEBUG=false

DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Groq Cloud chatbot (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Email delivery (SMTP via PHPMailer — e.g. Gmail app password, Brevo, Mailgun)
# Leave MAIL_HOST empty to fall back to the server's PHP mail() function.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@your-domain.com
MAIL_FROM_NAME=TourBan
# tls | ssl | none
MAIL_ENCRYPTION=tls

# Payment gateway selection: sandbox | sslcommerz | stripe | paypal
# sandbox = simulated checkout, no credentials needed (default).
PAYMENT_GATEWAY=sandbox

# SSLCommerz (https://developer.sslcommerz.com) — leave empty until enabled
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# 1 = sandbox/test mode, 0 = live
SSLCOMMERZ_SANDBOX=1

# Stripe (https://dashboard.stripe.com/apikeys) — leave empty until enabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (https://developer.paypal.com) — leave empty until enabled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
