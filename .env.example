# TourBan environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Application
# Public URL of the site with NO trailing slash (empty = domain root)
APP_URL=
# Show detailed error messages (true only in local development)
APP_DEBUG=false
# local | production
APP_ENV=production

# Database (MySQL / MariaDB)
DB_HOST=localhost
DB_NAME=tourban_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# xAI Grok API (chatbot)
# Get your key at https://console.x.ai
XAI_API_KEY=your_grok_api_key_here
# Optional model override (defaults to grok-2-latest)
XAI_MODEL=grok-2-latest
# Official xAI API endpoint
XAI_API_BASE=https://api.x.ai/v1
