# TourBan environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

APP_URL=https://your-domain.com
APP_ENV=production
APP_DEBUG=false

DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Groq Cloud chatbot (https://console.groq.com/keys)
# Keep the key server-side only: it is read in config/env.php and used by
# api/chatbot.php. It is never sent to the browser.
GROQ_API_KEY=
# Recommended active model. Older llama-3.1-8b-instant is decommissioned by
# Groq and returns "model_not_found"; keep this value in the GROQ_MODEL secret.
GROQ_MODEL=openai/gpt-oss-20b

# Email delivery (SMTP via PHPMailer — e.g. Gmail app password, Brevo, Mailgun)
# Leave MAIL_HOST empty to fall back to the server's PHP mail() function.
# For Gmail use an App Password (not the normal account password).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address used for OTP / notification emails.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TourBan
# Absolute, publicly reachable logo URL used in emails.
# Leave empty to use APP_URL/assets/images/logo.png automatically.
# IMPORTANT: production MUST set an HTTPS URL, e.g.
#   MAIL_LOGO_URL=https://your-domain.com/assets/images/logo.png
# Email clients cannot load http://localhost/... or local filesystem paths,
# so on localhost the logo will simply be skipped and the wordmark is shown.
MAIL_LOGO_URL=

# One-time code (OTP) lifetime in minutes for password reset and verification.
OTP_EXPIRY_MINUTES=15
# tls | ssl | none
MAIL_ENCRYPTION=tls

# Payment gateway selection: sandbox | sslcommerz | stripe | paypal
# sandbox = simulated checkout, no credentials needed (default).
PAYMENT_GATEWAY=sandbox

# SSLCommerz (https://developer.sslcommerz.com) — leave empty until enabled
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# 1 = sandbox/test mode, 0 = live
SSLCOMMERZ_SANDBOX=1

# Stripe (https://dashboard.stripe.com/apikeys) — leave empty until enabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (https://developer.paypal.com) — leave empty until enabled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
