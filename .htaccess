# TourBan production Apache configuration

Options -Indexes

# Protect environment and config files
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(log|ini|md)$">
    Require all denied
</FilesMatch>

# Block direct web access to config directory and internal files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config(/|$) - [F,L,NC]
    RewriteRule ^includes(/|$) - [F,L,NC]
    RewriteRule ^admin/includes(/|$) - [F,L,NC]
    RewriteRule ^migrations\.sql$ - [F,L,NC]
    RewriteRule ^database\.sql$ - [F,L,NC]
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]

    # Clean URLs - redirect old .php URLs to clean
    RewriteCond %{THE_REQUEST} \s/+about\.php\s [NC]
    RewriteRule ^about\.php$ /about [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+services\.php\s [NC]
    RewriteRule ^services\.php$ /services [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+destinations\.php\s [NC]
    RewriteRule ^destinations\.php$ /destinations [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+contact\.php\s [NC]
    RewriteRule ^contact\.php$ /contact [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+login\.php\s [NC]
    RewriteRule ^login\.php$ /login [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+register\.php\s [NC]
    RewriteRule ^register\.php$ /register [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+forgot-password\.php\s [NC]
    RewriteRule ^forgot-password\.php$ /forgot-password [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+dashboard\.php\s [NC]
    RewriteRule ^dashboard\.php$ /dashboard [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+profile\.php\s [NC]
    RewriteRule ^profile\.php$ /profile [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+booking\.php\s [NC]
    RewriteRule ^booking\.php$ /booking [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+payment\.php\s [NC]
    RewriteRule ^payment\.php$ /payment [R=301,L]

    # Clean URLs - internal rewrites (exclude protected)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^about/?$ about.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^services/?$ services.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^destinations/?$ destinations.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^contact/?$ contact.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^login/?$ login.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^register/?$ register.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^forgot-password/?$ forgot-password.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^dashboard/?$ dashboard.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^profile/?$ profile.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^booking/?$ booking.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/config/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteRule ^payment/?$ payment.php [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
