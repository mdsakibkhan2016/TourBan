
# Clean URLs - remove .php extension
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /TourBan-Project/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(TourBan-Project/)*([^/]+)\.php\s [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/api/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/admin/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/assets/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/includes/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/config/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/uploads/ [NC]
    RewriteRule ^(.*)\.php$ /TourBan-Project/%2 [R=301,L]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/api/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/admin/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/assets/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/includes/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/config/ [NC]
    RewriteCond %{REQUEST_URI} !^/TourBan-Project/uploads/ [NC]
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^/.]+)/?$ $1.php [L]
</IfModule>